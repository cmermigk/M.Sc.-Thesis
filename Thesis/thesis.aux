\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Gravitational lensing of a point source (red dot) by a near-extremal Kerr black hole ($a=0.998$). The two large crescent arcs represent the primary and secondary images, while the tiny red dots near the center correspond to higher-order photon sub-rings (photons that have orbited the black hole multiple times).}}{32}{figure.4.5}\protected@file@percent }
\newlabel{fig:point_source_lensing}{{4.5}{32}{Gravitational lensing of a point source (red dot) by a near-extremal Kerr black hole ($a=0.998$). The two large crescent arcs represent the primary and secondary images, while the tiny red dots near the center correspond to higher-order photon sub-rings (photons that have orbited the black hole multiple times)}{figure.4.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Shadow Morphology and Frame Dragging}{33}{subsection.4.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Simulated shadow of a near-extremal Kerr black hole ($a=0.998, M=1$) illuminated by the four-colour calibration celestial sphere. The pronounced "D" shape of the mathematical shadow is a direct manifestation of frame-dragging, which breaks the equatorial symmetry. The distinct colour quadrants verify the correct orientation and handedness of the backward ray-tracing mapping.}}{33}{figure.4.6}\protected@file@percent }
\newlabel{fig:placeholder1}{{4.6}{33}{Simulated shadow of a near-extremal Kerr black hole ($a=0.998, M=1$) illuminated by the four-colour calibration celestial sphere. The pronounced "D" shape of the mathematical shadow is a direct manifestation of frame-dragging, which breaks the equatorial symmetry. The distinct colour quadrants verify the correct orientation and handedness of the backward ray-tracing mapping}{figure.4.6}{}}
