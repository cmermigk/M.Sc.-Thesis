\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Demonstration of the Manifold Projection algorithm on a simple harmonic oscillator ($\dot  {x}=y, \dot  {y}=-x$) constrained to a unit circle. \textbf  {Left:} The phase-space trajectory integrated using a standard 4th-order Runge-Kutta scheme (red) exhibits inward spiraling (amplitude decay) due to unconstrained numerical drift, whereas the manifold-projected RK4 (blue) remains exactly on the constraint surface. \textbf  {Right:} The evolution of the radial distance over time ($t \in [0, 10000]$ with step $dt=0.3$), explicitly showing the amplitude decay in the unconstrained method versus the exact conservation achieved by projection.}}{27}{figure.4.1}\protected@file@percent }
\newlabel{fig:errors_projection}{{4.1}{27}{Demonstration of the Manifold Projection algorithm on a simple harmonic oscillator ($\dot {x}=y, \dot {y}=-x$) constrained to a unit circle. \textbf {Left:} The phase-space trajectory integrated using a standard 4th-order Runge-Kutta scheme (red) exhibits inward spiraling (amplitude decay) due to unconstrained numerical drift, whereas the manifold-projected RK4 (blue) remains exactly on the constraint surface. \textbf {Right:} The evolution of the radial distance over time ($t \in [0, 10000]$ with step $dt=0.3$), explicitly showing the amplitude decay in the unconstrained method versus the exact conservation achieved by projection}{figure.4.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.1}Fundamental Photon Orbits and Dynamics}{28}{subsection.4.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.2}Scattering Orbits}{28}{subsection.4.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Numerical integration of a scattering orbit by a near-extremal Kerr black hole ($a=0.998, M=1$). The initial conditions correspond to an impact parameter slightly larger than the critical value ($|b| > b_c$). \textbf  {Top Row (Left to Right):} Relative radial deviation showing the absence of discontinuous jumps, the radial distance $r(\TextOrMath  {\textlambda }{\mathlambda })$ exhibiting the characteristic "V" shape turnaround, and the full 3D spatial trajectory. \textbf  {Bottom Row (Left to Right):} Relative errors in conserved energy ($\TextOrMath  {\textDelta }{\mathDelta }E / E_0$), axial angular momentum ($\TextOrMath  {\textDelta }{\mathDelta }L_z / L_{z0}$), and the absolute error of the null constraint ($g_{\TextOrMath  {\textmu }{\mathmu }\TextOrMath  {\textnu }{\mathnu }}u^\TextOrMath  {\textmu }{\mathmu }u^\TextOrMath  {\textnu }{\mathnu }$). The integration was performed using a 7th-order Verner method with Manifold Projection (tolerances set to $10^{-15}$), strictly bounding all errors near machine precision.}}{29}{figure.4.2}\protected@file@percent }
\newlabel{fig:err2}{{4.2}{29}{Numerical integration of a scattering orbit by a near-extremal Kerr black hole ($a=0.998, M=1$). The initial conditions correspond to an impact parameter slightly larger than the critical value ($|b| > b_c$). \textbf {Top Row (Left to Right):} Relative radial deviation showing the absence of discontinuous jumps, the radial distance $r(\lambda )$ exhibiting the characteristic "V" shape turnaround, and the full 3D spatial trajectory. \textbf {Bottom Row (Left to Right):} Relative errors in conserved energy ($\Delta E / E_0$), axial angular momentum ($\Delta L_z / L_{z0}$), and the absolute error of the null constraint ($g_{\mu \nu }u^\mu u^\nu $). The integration was performed using a 7th-order Verner method with Manifold Projection (tolerances set to $10^{-15}$), strictly bounding all errors near machine precision}{figure.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.3}Bound Spiral Orbits (Transient Capture)}{29}{subsection.4.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Numerical integration of a bound spiral orbit (transient capture) near the critical impact parameter ($|b| \approx b_c$) for a Kerr black hole ($a=0.998, M=1$). \textbf  {Top Row:} Relative radial deviation, monotonic radial plunge $r(\TextOrMath  {\textlambda }{\mathlambda })$, and the 3D trajectory showing multiple revolutions around the unstable photon sphere before horizon penetration. \textbf  {Bottom Row:} Evolution of errors in energy, angular momentum, and the null constraint. Despite the exponential sensitivity (Lyapunov divergence) in this region, the Manifold Projection algorithm maintains all invariant errors strictly below the $10^{-12}$ threshold until the trajectory reaches the event horizon.}}{30}{figure.4.3}\protected@file@percent }
\newlabel{fig:err1}{{4.3}{30}{Numerical integration of a bound spiral orbit (transient capture) near the critical impact parameter ($|b| \approx b_c$) for a Kerr black hole ($a=0.998, M=1$). \textbf {Top Row:} Relative radial deviation, monotonic radial plunge $r(\lambda )$, and the 3D trajectory showing multiple revolutions around the unstable photon sphere before horizon penetration. \textbf {Bottom Row:} Evolution of errors in energy, angular momentum, and the null constraint. Despite the exponential sensitivity (Lyapunov divergence) in this region, the Manifold Projection algorithm maintains all invariant errors strictly below the $10^{-12}$ threshold until the trajectory reaches the event horizon}{figure.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.4}Direct Capture Orbits}{30}{subsection.4.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Numerical integration of a direct capture orbit ($|b| < b_c$) in a Kerr spacetime ($a=0.998, M=1$). The photon lacks sufficient angular momentum to overcome the effective potential barrier. \textbf  {Top Row:} Relative radial change, the rapidly decreasing radial distance $r(\TextOrMath  {\textlambda }{\mathlambda })$ towards the event horizon, and the 3D plunge trajectory. \textbf  {Bottom Row:} Constraint errors along the affine parameter. The physical invariants remain conserved to machine precision, avoiding unphysical numerical oscillations near the coordinate singularity.}}{31}{figure.4.4}\protected@file@percent }
\newlabel{fig:err3}{{4.4}{31}{Numerical integration of a direct capture orbit ($|b| < b_c$) in a Kerr spacetime ($a=0.998, M=1$). The photon lacks sufficient angular momentum to overcome the effective potential barrier. \textbf {Top Row:} Relative radial change, the rapidly decreasing radial distance $r(\lambda )$ towards the event horizon, and the 3D plunge trajectory. \textbf {Bottom Row:} Constraint errors along the affine parameter. The physical invariants remain conserved to machine precision, avoiding unphysical numerical oscillations near the coordinate singularity}{figure.4.4}{}}
