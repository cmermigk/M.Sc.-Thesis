\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Simulated emission from a geometrically thin accretion disk around a non-rotating Schwarzschild black hole ($a=0, M=1$). The observed intensity exhibits strong left-right asymmetry due to relativistic Doppler boosting of the approaching plasma on the left side. In the absence of spacetime rotation, the central mathematical shadow bounded by the primary photon ring remains perfectly circular.}}{35}{figure.4.8}\protected@file@percent }
\newlabel{fig:disk_schwarzschild}{{4.8}{35}{Simulated emission from a geometrically thin accretion disk around a non-rotating Schwarzschild black hole ($a=0, M=1$). The observed intensity exhibits strong left-right asymmetry due to relativistic Doppler boosting of the approaching plasma on the left side. In the absence of spacetime rotation, the central mathematical shadow bounded by the primary photon ring remains perfectly circular}{figure.4.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Simulated emission from a geometrically thin accretion disk around a near-extremal Kerr black hole ($a=0.998$). In contrast to the Schwarzschild geometry, the extreme frame-dragging drastically deforms the spacetime. This results in the characteristic "D"-shaped compression of both the photon ring and the inner edge of the accretion disk on the co-rotating side.}}{36}{figure.4.9}\protected@file@percent }
\newlabel{fig:disk_image}{{4.9}{36}{Simulated emission from a geometrically thin accretion disk around a near-extremal Kerr black hole ($a=0.998$). In contrast to the Schwarzschild geometry, the extreme frame-dragging drastically deforms the spacetime. This results in the characteristic "D"-shaped compression of both the photon ring and the inner edge of the accretion disk on the co-rotating side}{figure.4.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Comprehensive astrophysical rendering of a near-extremal Kerr black hole ($a=0.998$) featuring a geometrically thin accretion disk and a realistic Milky Way background. The visualization accurately resolves the primary disk emission subject to Doppler boosting, the strongly lensed image of the disk's far side wrapping over the poles, and the sharp hierarchy of higher-order photon sub-rings preserved by the geometric integration scheme.}}{37}{figure.4.10}\protected@file@percent }
\newlabel{fig:disk_images}{{4.10}{37}{Comprehensive astrophysical rendering of a near-extremal Kerr black hole ($a=0.998$) featuring a geometrically thin accretion disk and a realistic Milky Way background. The visualization accurately resolves the primary disk emission subject to Doppler boosting, the strongly lensed image of the disk's far side wrapping over the poles, and the sharp hierarchy of higher-order photon sub-rings preserved by the geometric integration scheme}{figure.4.10}{}}
